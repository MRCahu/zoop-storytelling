    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 🔹 Definindo as cores da identidade visual\n",
    "CINZA_1 = \"#F2F2F2\"\n",
    "CINZA_5 = \"#4F4F4F\"\n",
